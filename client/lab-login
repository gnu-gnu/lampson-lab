#!/usr/bin/env bash
# lab-login <principal> <user@host> [command...]      (CONTRACT §6)
#   1. fetch the current uid's SVID   2. get an SSH certificate from x5c-spire
#   3. ssh with that certificate only (no other keys, no agent)
# Prints the certificate's key id, serial and validity to stderr, so the
# sshd log line can be matched to it (AC-18).
set -euo pipefail

(($# >= 2)) || { echo "usage: lab-login <principal> <user@host> [command...]" >&2; exit 2; }
principal=$1 target=$2
shift 2

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT
cert=$(lab-ssh-cert --out "${dir}/id_ecdsa" "$principal")
ssh-keygen -L -f "$cert" | awk '
  /Key ID:/ { id = $3 } /Serial:/ { serial = $2 } /Valid:/ { valid = $3 " " $4 " " $5 }
  END { printf "lab-login: certificate key id %s, serial %s, valid %s\n", id, serial, valid }' >&2

mkdir -p -m 0700 "${HOME}/.ssh"
ssh -i "${dir}/id_ecdsa" -o CertificateFile="$cert" -o IdentitiesOnly=yes \
  -o IdentityAgent=none -o StrictHostKeyChecking=accept-new \
  -o UserKnownHostsFile="${HOME}/.ssh/known_hosts" -o ConnectTimeout=10 \
  "$target" "$@"
